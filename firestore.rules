rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users collection
    match /users/{userId} {
      // Allow user creation upon registration when auth.uid matches document ID
      allow create: if isOwner(userId);
      // Allow users to read and update their own profile, or admins to read/update any profile
      allow read, update: if isOwner(userId) || isAdmin();
      // Allow admins to delete user accounts
      allow delete: if isAdmin();

      // Progress subcollection
      match /progress/{lessonId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admins collection
    match /admins/{adminId} {
      // Signed-in users can check admin status
      allow read: if isSignedIn();
      // Write access disabled (managed manually in Firebase Console)
      allow write: if false;
    }

    // Donations collection
    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() || isAdmin();
    }
  }
}
